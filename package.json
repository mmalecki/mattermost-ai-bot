{
  "name": "@mmalecki/mattermost-ai-bot",
  "version": "0.1.1-1",
  "description": "AI bot for Mattermost: an LLM agent that takes part in your threads and gets things done with tools, from web research to MCP servers",
  "keywords": [
    "mattermost",
    "mattermost-bot",
    "ai",
    "agent",
    "llm",
    "chatbot",
    "mcp",
    "openai-compatible",
    "web-search",
    "self-hosted",
    "pi"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Maciej Małecki <me@mmalecki.com>",
  "engines": {
    "node": ">=24.1"
  },
  "bin": {
    "mattermost-ai-bot": "dist/index.js"
  },
  "files": [
    "dist",
    "mcp.example.json"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "eval": "node --env-file-if-exists=.env eval/tool-use.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "~1.4.0",
    "@earendil-works/pi-coding-agent": "~1.4.0",
    "@mattermost/client": "^11.9.0",
    "@mattermost/types": "^11.9.0",
    "@mmalecki/feather-pi-web": "^0.2.0",
    "jiti": "^2.7.0",
    "micromatch": "^4.0.8",
    "pi-ate-scheduler": "github:catlain/pi-scheduler#6541484891e7e23eece658b25934faef1358f369"
  },
  "overrides": {
    "@mattermost/client": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
