{
  "name": "mattermost-ai-bot",
  "version": "0.1.0",
  "description": "AI bot for Mattermost: an LLM agent that takes part in your threads and gets things done with tools, from web research to MCP servers",
  "keywords": [
    "mattermost",
    "mattermost-bot",
    "ai",
    "agent",
    "llm",
    "chatbot",
    "mcp",
    "openai-compatible",
    "web-search",
    "self-hosted",
    "pi"
  ],
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Maciej Małecki <me@mmalecki.com>",
  "engines": {
    "node": ">=24.1"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@mattermost/client": "^11.9.0",
    "@mattermost/types": "^11.9.0",
    "@mmalecki/feather-pi-web": "^0.1.0"
  },
  "overrides": {
    "@mattermost/client": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.4"
  }
}
